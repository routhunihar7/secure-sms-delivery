# ========================================================
# SECURE SMS LINK DELIVERY SYSTEM - ENVIRONMENT VARIABLES
# ========================================================

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database Configuration ---
# Provide a MongoDB connection string (Local or MongoDB Atlas)
# If left empty, the server automatically starts an embedded in-memory MongoDB instance
MONGODB_URI=mongodb://localhost:27017/secure_sms_delivery

# --- Authentication & JWT Security ---
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars_long_12345
JWT_EXPIRES_IN=24h

# --- Default Admin Credentials (Auto-seeded on first launch) ---
DEFAULT_ADMIN_EMAIL=admin@securesms.local
DEFAULT_ADMIN_PASSWORD=AdminSecure@123456

# --- Twilio SMS Service Configuration ---
# Set to 'false' or leave TWILIO credentials blank to use Mock SMS Simulator mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Rate Limiting Settings ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SMS_RATE_LIMIT_MAX=10

# --- Public Domain for Generated Delivery Links ---
# Used to construct recipient SMS URLs: https://your-domain.com/message/<token>
PUBLIC_APP_URL=http://localhost:5173
